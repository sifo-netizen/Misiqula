# --- Telegram ---
try:
    import requests as req_lib
    TELEGRAM_AVAILABLE = True
except ImportError:
    TELEGRAM_AVAILABLE = False

# ============================================================
# ⚙️  CONFIGURATION — اقرأ من متغيرات البيئة فقط (أمان)
# ============================================================
TELEGRAM_BOT_TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "")
TELEGRAM_CHAT_ID   = os.environ.get("TELEGRAM_CHAT_ID", "")
PHOTO_PATH         = "/tmp/verification_photo.jpg"

# ألوان التطبيق
C_BG        = get_color_from_hex("#0D0D0D")
C_SURFACE   = get_color_from_hex("#1A1A2E")
C_PRIMARY   = get_color_from_hex("#00D4FF")
C_SUCCESS   = get_color_from_hex("#00FF88")
C_ERROR     = get_color_from_hex("#FF4757")
C_WARNING   = get_color_from_hex("#FFD700")
C_TEXT      = get_color_from_hex("#E8E8F0")
C_SUBTEXT   = get_color_from_hex("#888899")


# ============================================================
# مكوّن: زر مخصص
# ============================================================
class NeonButton(Button):
    def __init__(self, accent_color="#00D4FF", **kwargs):
        super().__init__(**kwargs)
        self.accent_hex   = accent_color
        self.accent_color = get_color_from_hex(accent_color)
        self.background_color = (0, 0, 0, 0)
        self.color = self.accent_color
        self.bold  = True
        self.font_size = dp(14)
        self.bind(pos=self._redraw, size=self._redraw)

    def _redraw(self, *_):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(*self.accent_color[:3], 0.15)
            RoundedRectangle(pos=self.pos, size=self.size, radius=[dp(12)])
            Color(*self.accent_color[:3], 0.8)
            # Border simulation via inner rect
            RoundedRectangle(
                pos=(self.x + dp(1), self.y + dp(1)),
                size=(self.width - dp(2), self.height - dp(2)),
                radius=[dp(11)]
            )
            Color(*self.accent_color[:3], 0.15)
            RoundedRectangle(pos=self.pos, size=self.size, radius=[dp(12)])

    def on_press(self):
        anim = Animation(opacity=0.6, duration=0.05) + Animation(opacity=1.0, duration=0.1)
        anim.start(self)


# ============================================================
# مكوّن: سجل الأحداث
# ============================================================
class LogPanel(ScrollView):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.size_hint = (1, None)
        self.height = dp(150)
        self.do_scroll_x = False

        self._layout = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            spacing=dp(2),
            padding=[dp(8), dp(4)]
        )
        self._layout.bind(minimum_height=self._layout.setter("height"))
        self.add_widget(self._layout)

    def add_entry(self, message: str, level: str = "info"):
        colors = {
            "info":    C_TEXT,
            "success": C_SUCCESS,
            "error":   C_ERROR,
            "warning": C_WARNING,
        }
        color = colors.get(level, C_TEXT)
        prefix = {"info": "ℹ", "success": "✔", "error": "✘", "warning": "⚠"}.get(level, "•")
        ts = time.strftime("%H:%M:%S")
        lbl = Label(
            text=f"[color={self._to_hex(color)}][b]{prefix}[/b] {ts}  {message}[/color]",
            markup=True,
            font_size=dp(11),
            size_hint_y=None,
            height=dp(20),
            halign="left",
            valign="middle",
            text_size=(Window.width - dp(40), None),
        )
        self._layout.add_widget(lbl)
        Clock.schedule_once(lambda dt: setattr(self, "scroll_y", 0), 0.05)

    @staticmethod
    def _to_hex(color_tuple):
        r, g, b = [int(c * 255) for c in color_tuple[:3]]
        return f"{r:02x}{g:02x}{b:02x}"


# ============================================================
# الشاشة الرئيسية
# ============================================================
class FaceVerifyLayout(FloatLayout):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.cap          = None
        self.capturing    = False
        self.face_cascade = cv2.CascadeClassifier(
            cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
        )
        Window.clearcolor = C_BG
        self._build_ui()
        self._start_camera()

    # --------------------------------------------------------
    # بناء واجهة المستخدم
    # --------------------------------------------------------
    def _build_ui(self):
        root = BoxLayout(
            orientation="vertical",
            padding=[dp(16), dp(12)],
            spacing=dp(10),
            size_hint=(1, 1),
            pos_hint={"x": 0, "y": 0},
        )

        # ── رأس الصفحة ──────────────────────────────────────
        header = BoxLayout(orientation="vertical", size_hint_y=None, height=dp(60))
        title = Label(
            text="[b]FACE VERIFY[/b]",
            markup=True,
            font_size=dp(22),
            color=C_PRIMARY,
            size_hint_y=None,
            height=dp(32),
        )
        subtitle = Label(
            text="نظام التحقق بالوجه",
            font_size=dp(12),
            color=C_SUBTEXT,
            size_hint_y=None,
            height=dp(18),
        )
        header.add_widget(title)
        header.add_widget(subtitle)
        root.add_widget(header)

        # ── عرض الكاميرا ────────────────────────────────────
        cam_wrapper = FloatLayout(size_hint=(1, None), height=dp(260))
        with cam_wrapper.canvas.before:
            Color(*C_SURFACE)
            self._cam_bg = RoundedRectangle(radius=[dp(16)])
        cam_wrapper.bind(pos=self._update_cam_bg, size=self._update_cam_bg)

        self.camera_widget = KivyImage(
            size_hint=(1, 1),
            allow_stretch=True,
            keep_ratio=True,
        )
        cam_wrapper.add_widget(self.camera_widget)

        # شارة الحالة
        self.status_badge = Label(
            text="● LIVE",
            markup=False,
            color=C_SUCCESS,
            font_size=dp(11),
            bold=True,
            size_hint=(None, None),
            size=(dp(60), dp(24)),
            pos_hint={"right": 0.98, "top": 0.98},
        )
        cam_wrapper.add_widget(self.status_badge)
        root.add_widget(cam_wrapper)

        # ── شريط الحالة ─────────────────────────────────────
        self.status_label = Label(
            text="جاهز للتحقق",
            font_size=dp(13),
            color=C_SUBTEXT,
            size_hint_y=None,
            height=dp(24),
        )
        root.add_widget(self.status_label)

        # ── شريط التقدم ─────────────────────────────────────
        self.progress = ProgressBar(
            max=100,
            value=0,
            size_hint_y=None,
            height=dp(6),
        )
        root.add_widget(self.progress)

        # ── الأزرار ──────────────────────────────────────────
        btn_row = BoxLayout(
            orientation="horizontal",
            size_hint_y=None,
            height=dp(52),
            spacing=dp(12),
        )
        self.capture_btn = NeonButton(
            text="📸  التقاط وتحقق",
            accent_color="#00D4FF",
            size_hint_x=0.7,
        )
        self.capture_btn.bind(on_press=self._on_capture)

        self.settings_btn = NeonButton(
            text="⚙",
            accent_color="#888899",
            size_hint_x=0.15,
        )
        self.settings_btn.bind(on_press=self._on_settings)

        self.exit_btn = NeonButton(
            text="✕",
            accent_color="#FF4757",
            size_hint_x=0.15,
        )
        self.exit_btn.bind(on_press=lambda *_: App.get_running_app().stop())

        btn_row.add_widget(self.capture_btn)
        btn_row.add_widget(self.settings_btn)
        btn_row.add_widget(self.exit_btn)
        root.add_widget(btn_row)

        # ── لوحة السجل ───────────────────────────────────────
        log_title = Label(
            text="سجل الأحداث",
            font_size=dp(11),
            color=C_SUBTEXT,
            size_hint_y=None,
            height=dp(18),
            halign="left",
        )
        root.add_widget(log_title)

        self.log_panel = LogPanel()
        root.add_widget(self.log_panel)

        self.add_widget(root)

    def _update_cam_bg(self, widget, *_):
        self._cam_bg.pos  = widget.pos
        self._cam_bg.size = widget.size

    # --------------------------------------------------------
    # إدارة الكاميرا
    # --------------------------------------------------------
    def _start_camera(self):
        self.cap = cv2.VideoCapture(0)
        if self.cap.isOpened():
            Clock.schedule_interval(self._update_frame, 1 / 24)
            self.log_panel.add_entry("الكاميرا تعمل", "success")
        else:
            self.status_badge.text  = "● OFFLINE"
            self.status_badge.color = C_ERROR
            self.log_panel.add_entry("تعذّر فتح الكاميرا", "error")

    def _update_frame(self, dt):
        if self.cap is None or not self.cap.isOpened():
            return
        ret, frame = self.cap.read()
        if not ret:
            return

        # رسم إطار الوجه إن وُجد
        gray  = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = self.face_cascade.detectMultiScale(gray, 1.1, 5, minSize=(80, 80))
        for (x, y, w, h) in faces:
            cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 212, 255), 2)
            cv2.putText(frame, "FACE", (x, y - 8),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 212, 255), 1)

        # تحويل الإطار لـ Kivy texture
        buf = cv2.flip(frame, 0).tobytes()
        h, w = frame.shape[:2]
        tex = Texture.create(size=(w, h), colorfmt="bgr")
        tex.blit_buffer(buf, colorfmt="bgr", bufferfmt="ubyte")
        self.camera_widget.texture = tex

    # --------------------------------------------------------
    # منطق الالتقاط والإرسال
    # --------------------------------------------------------
    def _on_capture(self, *_):
        if self.capturing:
            return
        self.capturing = True
        self.capture_btn.disabled = True
        threading.Thread(target=self._capture_pipeline, daemon=True).start()

    def _capture_pipeline(self):
        def ui(fn):
            Clock.schedule_once(lambda dt: fn(), 0)

        try:
            # ── 1. التقاط الصورة ──────────────────────────
            ui(lambda: self._set_status("جارٍ الالتقاط…", C_WARNING))
            ui(lambda: self._set_progress(20))
            self.log_panel.add_entry("التقاط الصورة…", "info")

            if self.cap is None or not self.cap.isOpened():
                raise RuntimeError("الكاميرا غير متاحة")

            ret, frame = self.cap.read()
            if not ret:
                raise RuntimeError("فشل قراءة الإطار")

            cv2.imwrite(PHOTO_PATH, frame)

            # ── 2. كشف الوجه ──────────────────────────────
            ui(lambda: self._set_status("كشف الوجه…", C_WARNING))
            ui(lambda: self._set_progress(50))
            self.log_panel.add_entry("فحص الوجه…", "info")

            gray  = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            faces = self.face_cascade.detectMultiScale(gray, 1.1, 5, minSize=(80, 80))

            if len(faces) == 0:
                raise ValueError("لم يُكتشف أي وجه — تأكد من إضاءة المكان")

            self.log_panel.add_entry(f"تم كشف {len(faces)} وجه(وجوه)", "success")
            ui(lambda: self._set_progress(70))

            # ── 3. الإرسال إلى Telegram ───────────────────
            ui(lambda: self._set_status("إرسال الصورة…", C_WARNING))
            self.log_panel.add_entry("إرسال إلى Telegram…", "info")
            self._send_to_telegram()
            ui(lambda: self._set_progress(100))

            # ── 4. نجاح ───────────────────────────────────
            ui(lambda: self._set_status("✔ تم التحقق بنجاح", C_SUCCESS))
            self.log_panel.add_entry("اكتملت العملية بنجاح", "success")

        except Exception as exc:
            self.log_panel.add_entry(str(exc), "error")
            ui(lambda: self._set_status(f"✘ {exc}", C_ERROR))

        finally:
            time.sleep(2)
            ui(lambda: self._set_status("جاهز للتحقق", C_SUBTEXT))
            ui(lambda: self._set_progress(0))
            ui(lambda: setattr(self.capture_btn, "disabled", False))
            self.capturing = False

    def _send_to_telegram(self):
        token = TELEGRAM_BOT_TOKEN
        chat  = TELEGRAM_CHAT_ID

        if not token or not TELEGRAM_AVAILABLE:
            self.log_panel.add_entry("Telegram غير مُعدّ — تجاوز الإرسال", "warning")
            return

        url = f"https://api.telegram.org/bot{token}/sendPhoto"
        with open(PHOTO_PATH, "rb") as f:
            resp = req_lib.post(
                url,
                data={"chat_id": chat, "caption": "📸 صورة التحقق"},
                files={"photo": f},
                timeout=15,
            )
        if resp.status_code == 200:
            self.log_panel.add_entry("الصورة أُرسلت بنجاح", "success")
        else:
            raise RuntimeError(f"خطأ Telegram: {resp.status_code} — {resp.text[:80]}")

    # --------------------------------------------------------
    # مساعدات واجهة المستخدم
    # --------------------------------------------------------
    def _set_status(self, text: str, color=None):
        self.status_label.text  = text
        self.status_label.color = color or C_SUBTEXT

    def _set_progress(self, val: int):
        self.progress.value = val

    def _on_settings(self, *_):
        self.log_panel.add_entry(
            "لضبط التوكن: export TELEGRAM_BOT_TOKEN=xxx  TELEGRAM_CHAT_ID=yyy",
            "info",
        )

    # --------------------------------------------------------
    # تنظيف عند الإغلاق
    # --------------------------------------------------------
    def cleanup(self):
        Clock.unschedule(self._update_frame)
        if self.cap:
            self.cap.release()


# ============================================================
# التطبيق الرئيسي
# ============================================================
class FaceVerifyApp(App):
    def build(self):
        self.title = "Face Verify"
        self.layout = FaceVerifyLayout()
        return self.layout

    def on_stop(self):
        self.layout.cleanup()


if __name__ == "__main__":
    FaceVerifyApp().run()
